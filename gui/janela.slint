// Janela principal do xiso-manager.
//
// Desempenho: nada se move sem motivo. Sem animações contínuas e sem
// desfoque; o painel translúcido é só cor com transparência. O disco é um
// SVG desenhado uma vez e guardado pelo Slint. A lista de jogos só cria os
// cartões que aparecem na tela.

import { ListView } from "std-widgets.slint";

export global Tema {
    out property <color> fundo: #14171c;
    out property <color> lateral: #0b0e11d0;
    // quase opaco: a matriz do fundo não pode atrapalhar a leitura
    out property <color> painel: #12161be8;
    out property <color> painel-hover: #1a1f26ec;
    out property <color> painel-lendo: #12161be7;
    out property <color> selecionado: #142a1ced;
    out property <color> painel-borda: #ffffff1a;
    out property <color> realce: #4ade80;
    out property <color> realce-fundo: #4ade801f;
    out property <color> texto: #e6edf3;
    out property <color> texto-fraco: #8b949e;
    out property <length> raio: 10px;
    out property <color> aviso: #f0b429;
}

export struct Jogo {
    caminho: string,
    nome: string,
    detalhe: string,
    aviso: string,
    icone: image,
    tem-icone: bool,
    lendo: bool,
    // depois de verificar: 1 idêntica ao Redump, 2 íntegra, 3 não confere
    selo: int,
}

component Cartao inherits Rectangle {
    in property <Jogo> jogo;
    in property <bool> selecionado;
    in property <bool> removivel: true;
    callback clicado;
    callback remover;

    height: 84px;
    border-radius: Tema.raio;
    // Durante a leitura o fundo é um tom invisivelmente diferente: quando
    // ela termina, o cartão inteiro é redesenhado. Sem isso, no desenho por
    // software sobrava um pedaço do nome antigo (a perna do "j" de
    // "jogo.iso" sai um pouco para fora da área do texto).
    background: root.selecionado ? Tema.selecionado : toque.has-hover ? Tema.painel-hover : root.jogo.lendo ? Tema.painel-lendo : Tema.painel;
    border-width: 1px;
    border-color: root.selecionado ? Tema.realce : Tema.painel-borda;

    toque := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicado();
        }
    }

    HorizontalLayout {
        padding: 12px;
        spacing: 14px;

        Rectangle {
            width: 60px;
            height: 60px;
            border-radius: 8px;
            background: #0b0d10;
            clip: true;

            if root.jogo.tem-icone: Image {
                source: root.jogo.icone;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
            if !root.jogo.tem-icone: Image {
                source: @image-url("imagens/icone.svg");
                width: 40px;
                height: 40px;
                opacity: root.jogo.lendo ? 0.25 : 0.6;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: root.jogo.nome;
                color: Tema.texto;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.jogo.lendo ? "Lendo…" : root.jogo.detalhe;
                color: Tema.texto-fraco;
                font-size: 12px;
                overflow: elide;
            }

            if root.jogo.aviso != "": Text {
                text: root.jogo.aviso;
                color: Tema.aviso;
                font-size: 12px;
                overflow: elide;
            }
        }

        if root.jogo.selo > 0 && !root.jogo.lendo: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                height: 24px;
                border-radius: 12px;
                background: root.jogo.selo == 1 ? #4ade8026 : root.jogo.selo == 3 ? #f0b42926 : #ffffff12;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: root.jogo.selo == 1 ? "✓ Redump" : root.jogo.selo == 3 ? "Não confere" : "Íntegra";
                        color: root.jogo.selo == 1 ? Tema.realce : root.jogo.selo == 3 ? Tema.aviso : Tema.texto-fraco;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // remover da biblioteca (o arquivo não é apagado)
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 6px;
                background: fechar.has-hover ? #ffffff1a : transparent;
                visible: root.removivel && (toque.has-hover || fechar.has-hover);
                Image {
                    source: @image-url("imagens/icones/fechar.svg");
                    colorize: Tema.texto-fraco;
                    width: 16px;
                    height: 16px;
                }

                fechar := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.remover();
                    }
                }
            }
        }
    }
}

component ItemMenu inherits Rectangle {
    in property <image> icone;
    in property <string> texto;
    in property <bool> ativo;
    callback clicado;

    height: 40px;
    border-radius: 8px;
    background: root.ativo ? Tema.realce-fundo : toque.has-hover ? #ffffff0a : transparent;

    // marca verde do item ativo
    Rectangle {
        x: 0;
        width: 3px;
        height: 20px;
        border-radius: 2px;
        background: root.ativo ? Tema.realce : transparent;
    }

    HorizontalLayout {
        padding-left: 16px;
        spacing: 12px;
        Image {
            source: root.icone;
            colorize: root.ativo ? Tema.realce : Tema.texto-fraco;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.texto;
            font-size: 14px;
            font-weight: root.ativo ? 600 : 400;
            color: root.ativo ? Tema.texto : Tema.texto-fraco;
            vertical-alignment: center;
        }
    }

    toque := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicado();
        }
    }
}

component Botao inherits Rectangle {
    in property <string> texto;
    in property <bool> ativo: true;
    // secundário: só a borda, para ações que não são a principal da tela
    in property <bool> secundario;
    callback clicado;

    height: 36px;
    min-width: 120px;
    border-radius: 8px;
    opacity: root.ativo ? 1 : 0.4;
    background: root.secundario ? (toque.has-hover && root.ativo ? Tema.painel-hover : Tema.painel) : toque.pressed ? #3bc46e : toque.has-hover && root.ativo ? #5ef093 : Tema.realce;
    border-width: root.secundario ? 1px : 0;
    border-color: Tema.painel-borda;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.texto;
            color: root.secundario ? Tema.texto : #0b1a10;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    toque := TouchArea {
        enabled: root.ativo;
        mouse-cursor: root.ativo ? pointer : default;
        clicked => {
            root.clicado();
        }
    }
}

// Caixa de marcar no tema da janela (a do Slint fica azul).
component CheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;

    height: 28px;
    opacity: root.enabled ? 1 : 0.4;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.checked ? Tema.realce : transparent;
            border-width: root.checked ? 0 : 1.5px;
            border-color: toque.has-hover && root.enabled ? Tema.texto : Tema.texto-fraco;
            if root.checked: Image {
                source: @image-url("imagens/icones/marca.svg");
                colorize: #0b1a10;
                width: 12px;
                height: 12px;
            }
        }

        Text {
            text: root.text;
            color: Tema.texto;
            vertical-alignment: center;
        }
    }

    toque := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
        }
    }
}

// Uma escolha entre opções (bolinha).
component Opcao inherits Rectangle {
    in property <string> texto;
    in property <bool> marcado;
    callback clicado;

    height: 28px;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            border-width: 1.5px;
            border-color: root.marcado ? Tema.realce : toque.has-hover ? Tema.texto : Tema.texto-fraco;
            if root.marcado: Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tema.realce;
            }
        }

        Text {
            text: root.texto;
            color: Tema.texto;
            vertical-alignment: center;
        }
    }

    toque := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicado();
        }
    }
}

// Número com menos e mais.
component SpinBox inherits Rectangle {
    in property <int> minimum;
    in property <int> maximum;
    in-out property <int> value;
    in property <bool> enabled: true;

    height: 36px;
    border-radius: 8px;
    background: #0b0d10;
    border-width: 1px;
    border-color: Tema.painel-borda;
    opacity: root.enabled ? 1 : 0.4;
    HorizontalLayout {
        menos := Rectangle {
            width: 34px;
            border-radius: 8px;
            background: toque-menos.has-hover && root.enabled ? #ffffff14 : transparent;
            Text {
                text: "−";
                color: Tema.texto;
                font-size: 16px;
            }

            toque-menos := TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.value = max(root.minimum, root.value - 1);
                }
            }
        }

        Text {
            text: root.value;
            color: Tema.texto;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 34px;
            border-radius: 8px;
            background: toque-mais.has-hover && root.enabled ? #ffffff14 : transparent;
            Text {
                text: "+";
                color: Tema.texto;
                font-size: 16px;
            }

            toque-mais := TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.value = min(root.maximum, root.value + 1);
                }
            }
        }
    }
}

// Um caminho escolhido pelo usuário, com o botão para trocar.
component CampoCaminho inherits VerticalLayout {
    in property <string> rotulo;
    in property <string> caminho;
    in property <string> vazio: "Nenhum escolhido";
    in property <bool> ativo: true;
    callback escolher;

    spacing: 6px;
    Text {
        text: root.rotulo;
        color: Tema.texto-fraco;
        font-size: 12px;
    }

    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            height: 36px;
            horizontal-stretch: 1;
            border-radius: 8px;
            background: #0b0d10;
            border-width: 1px;
            border-color: Tema.painel-borda;
            opacity: root.ativo ? 1 : 0.4;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: root.caminho != "" ? root.caminho : root.vazio;
                    color: root.caminho != "" ? Tema.texto : Tema.texto-fraco;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        Botao {
            texto: "Escolher…";
            secundario: true;
            horizontal-stretch: 0;
            ativo: root.ativo;
            clicado => {
                root.escolher();
            }
        }
    }
}

component Painel inherits Rectangle {
    background: Tema.painel;
    border-width: 1px;
    border-color: Tema.painel-borda;
    border-radius: Tema.raio;
}

// Cabeçalho das páginas de ação.
component Titulo inherits VerticalLayout {
    in property <string> titulo;
    in property <string> descricao;
    spacing: 4px;
    Text {
        text: root.titulo;
        color: Tema.texto;
        font-size: 24px;
        font-weight: 700;
    }

    Text {
        text: root.descricao;
        color: Tema.texto-fraco;
        font-size: 13px;
        wrap: word-wrap;
    }
}

export component Janela inherits Window {
    in property <string> versao;
    in-out property <int> secao: 0;
    in property <string> renderizador;
    in property <[Jogo]> jogos;
    in property <string> resumo;
    in property <bool> arrastando;
    in property <int> selecionado: -1;
    callback adicionar();
    callback remover(int);
    callback selecionar(int);

    // opções das ações
    in property <string> destino-god;
    in-out property <int> threads: 4;
    in-out property <bool> cortar-fim: true;
    in property <string> destino-extrair;
    in-out property <bool> pular-atualizacao;
    // "substituir se já existir", um por tela: marcado numa não vale na outra
    in-out property <bool> sobrescrever-extrair;
    in-out property <bool> sobrescrever-criar;
    in-out property <bool> sobrescrever-reescrever;
    in-out property <bool> liberar-midia;
    in property <string> pasta-criar;
    in property <string> saida-criar;
    in-out property <bool> substituir-original;
    in property <string> saida-reescrever;
    in property <string> aviso-acao;
    in-out property <bool> todos;
    // 1 destino do GOD, 2 destino da extração, 3 pasta do jogo (criar),
    // 4 ISO a criar, 5 ISO reescrita
    callback escolher(int);
    // 1 converter, 2 extrair, 3 criar, 4 reescrever, 5 verificar
    callback iniciar(int);

    // a tarefa: 0 nenhuma, 1 rodando, 2 concluída, 3 erro, 4 cancelada,
    // 5 concluída com ressalva (verificar: não confere)
    in property <int> tarefa-estado;
    in property <string> tarefa-titulo;
    in property <string> tarefa-detalhe;
    in property <float> tarefa-fracao: -1;
    in property <string> tarefa-pasta;
    in property <bool> cancelando;
    // pedidos esperando a vez
    in property <int> fila;
    callback esvaziar-fila();
    callback cancelar();
    callback abrir-pasta();
    callback limpar-tarefa();

    // configurações
    in property <string> cfg-extract;
    in property <string> cfg-extract-estado;
    in property <string> cfg-iso2god;
    in property <string> cfg-iso2god-estado;
    in property <string> cfg-pasta;
    in-out property <int> cfg-threads: 4;
    in-out property <bool> cfg-gpu;
    // 1 pasta padrão, 2 extract-xiso-pt, 3 iso2god-pt
    callback cfg-escolher(int);
    changed cfg-threads => {
        root.threads = root.cfg-threads;
        root.cfg-mudou();
    }
    changed cfg-gpu => {
        root.cfg-mudou();
    }
    callback cfg-mudou();

    property <bool> ocupado: root.tarefa-estado == 1;
    property <bool> tem-jogo: root.selecionado >= 0 && root.selecionado < root.jogos.length;

    title: "xiso-manager";
    icon: @image-url("imagens/logo.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 600px;
    background: Tema.fundo;
    default-font-size: 14px;

    // a matriz binária, escurecida; desenhada uma vez e guardada
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("imagens/fundo.jpg");
        image-fit: cover;
    }

    HorizontalLayout {
        // ── barra lateral ───────────────────────────────────────────────
        Rectangle {
            width: 230px;
            background: Tema.lateral;

            VerticalLayout {
                padding: 16px;
                padding-top: 24px;
                spacing: 4px;

                Image {
                    source: @image-url("imagens/logo.png");
                    height: 190px;
                    image-fit: contain;
                }

                Text {
                    text: "v" + root.versao;
                    color: Tema.texto-fraco;
                    font-size: 12px;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 20px;
                }

                ItemMenu {
                    icone: @image-url("imagens/icones/biblioteca.svg");
                    texto: "Biblioteca";
                    ativo: root.secao == 0;
                    clicado => {
                        root.secao = 0;
                    }
                }

                ItemMenu {
                    icone: @image-url("imagens/icones/converter.svg");
                    texto: "Converter para GOD";
                    ativo: root.secao == 1;
                    clicado => {
                        root.secao = 1;
                    }
                }

                ItemMenu {
                    icone: @image-url("imagens/icones/extrair.svg");
                    texto: "Extrair";
                    ativo: root.secao == 2;
                    clicado => {
                        root.secao = 2;
                    }
                }

                ItemMenu {
                    icone: @image-url("imagens/icones/criar.svg");
                    texto: "Criar ISO";
                    ativo: root.secao == 3;
                    clicado => {
                        root.secao = 3;
                    }
                }

                ItemMenu {
                    icone: @image-url("imagens/icones/reescrever.svg");
                    texto: "Reescrever";
                    ativo: root.secao == 4;
                    clicado => {
                        root.secao = 4;
                    }
                }

                ItemMenu {
                    icone: @image-url("imagens/icones/verificar.svg");
                    texto: "Verificar";
                    ativo: root.secao == 5;
                    clicado => {
                        root.secao = 5;
                    }
                }

                Rectangle { }

                ItemMenu {
                    icone: @image-url("imagens/icones/configuracoes.svg");
                    texto: "Configurações";
                    ativo: root.secao == 6;
                    clicado => {
                        root.secao = 6;
                    }
                }
            }
        }

        // ── conteúdo ────────────────────────────────────────────────────
        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            // Biblioteca
            if root.secao == 0: VerticalLayout {
                spacing: 16px;
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Biblioteca";
                            color: Tema.texto;
                            font-size: 24px;
                            font-weight: 700;
                        }

                        if root.resumo != "": Text {
                            text: root.resumo;
                            color: Tema.texto-fraco;
                            font-size: 12px;
                        }
                    }

                    Rectangle { }

                    Botao {
                        texto: "+ Adicionar";
                        clicado => {
                            root.adicionar();
                        }
                    }
                }

                // a lista de jogos; vazia, o convite para adicionar
                Rectangle {
                    vertical-stretch: 1;
                    background: root.jogos.length == 0 || root.arrastando ? Tema.painel : transparent;
                    border-width: root.jogos.length == 0 || root.arrastando ? 1px : 0;
                    border-color: root.arrastando ? Tema.realce : Tema.painel-borda;
                    border-radius: Tema.raio;

                    if root.jogos.length > 0: ListView {
                        for jogo[i] in root.jogos: VerticalLayout {
                            padding-bottom: 8px;
                            Cartao {
                                jogo: jogo;
                                selecionado: root.selecionado == i;
                                clicado => {
                                    root.selecionar(i);
                                }
                                remover => {
                                    root.remover(i);
                                }
                            }
                        }
                    }

                    if root.jogos.length == 0 || root.arrastando: Rectangle {
                        background: root.arrastando ? #14171ce6 : transparent;
                        border-radius: Tema.raio;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            Image {
                                source: @image-url("imagens/icone.svg");
                                height: 72px;
                                image-fit: contain;
                                opacity: root.arrastando ? 1 : 0.35;
                            }

                            Text {
                                text: root.arrastando ? "Solte para adicionar" : "Arraste ISOs (ou uma pasta com ISOs) para cá, ou clique em Adicionar";
                                color: root.arrastando ? Tema.realce : Tema.texto-fraco;
                                font-size: 15px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // Páginas de ação: o jogo escolhido na Biblioteca, as opções e
            // o botão Iniciar.
            if root.secao >= 1 && root.secao <= 5: VerticalLayout {
                spacing: 18px;
                vertical-stretch: 1;

                Titulo {
                    titulo: root.secao == 1 ? "Converter para GOD" : root.secao == 2 ? "Extrair" : root.secao == 3 ? "Criar ISO" : root.secao == 4 ? "Reescrever" : "Verificar";
                    descricao: root.secao == 1 ? "Transforma a ISO num pacote Games on Demand, que o console abre pelo disco rígido (Aurora, FreeStyle)." : root.secao == 2 ? "Copia todos os arquivos de dentro da ISO para uma pasta." : root.secao == 3 ? "Monta uma ISO a partir da pasta de um jogo de Xbox ou Xbox 360." : root.secao == 4 ? "Regrava a ISO enxuta: tira a partição de vídeo e o espaço vazio, sem perder nada do jogo." : "Lê a ISO inteira, confere a estrutura e compara com o Redump (se os .dat estiverem instalados).";
                }

                // o jogo (menos no Criar, que parte de uma pasta)
                if root.secao != 3 && root.todos && root.jogos.length > 0: Painel {
                    height: 84px;
                    HorizontalLayout {
                        padding: 16px;
                        Text {
                            text: root.jogos.length == 1 ? "O jogo da Biblioteca" : "Os " + root.jogos.length + " jogos da Biblioteca, um depois do outro";
                            color: Tema.texto;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.secao != 3 && !root.todos && root.tem-jogo: Cartao {
                    jogo: root.jogos[root.selecionado];
                    selecionado: true;
                    removivel: false;
                    clicado => {
                        root.secao = 0;
                    }
                }
                if root.secao != 3 && !(root.todos && root.jogos.length > 0) && !root.tem-jogo: Painel {
                    height: 84px;
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text {
                            text: "Escolha um jogo na Biblioteca.";
                            color: Tema.texto-fraco;
                            vertical-alignment: center;
                        }

                        Rectangle { }

                        Botao {
                            texto: "Ir para a Biblioteca";
                            secundario: true;
                            y: (parent.height - self.height) / 2;
                            clicado => {
                                root.secao = 0;
                            }
                        }
                    }
                }

                if root.secao != 3 && root.jogos.length > 1: CheckBox {
                    text: "Fazer com todos os jogos da Biblioteca (" + root.jogos.length + ")";
                    checked <=> root.todos;
                }

                // opções
                if root.secao == 1: VerticalLayout {
                    spacing: 14px;
                    CampoCaminho {
                        rotulo: "Pasta de destino (o pacote fica em <pasta>/<Title ID>/…)";
                        caminho: root.destino-god;
                        escolher => {
                            root.escolher(1);
                        }
                    }

                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: "Threads";
                                color: Tema.texto-fraco;
                                vertical-alignment: center;
                            }

                            SpinBox {
                                width: 110px;
                                minimum: 1;
                                maximum: 32;
                                value <=> root.threads;
                                    }
                        }

                        CheckBox {
                            text: "Cortar o espaço vazio do fim da ISO";
                            checked <=> root.cortar-fim;
                            }
                    }
                }

                if root.secao == 2: VerticalLayout {
                    spacing: 14px;
                    CampoCaminho {
                        rotulo: "Pasta de destino";
                        caminho: root.todos ? "" : root.destino-extrair;
                        vazio: "Uma pasta ao lado de cada ISO, com o nome do jogo";
                        ativo: !root.todos;
                        escolher => {
                            root.escolher(2);
                        }
                    }

                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        CheckBox {
                            text: "Pular a atualização do console ($SystemUpdate)";
                            checked <=> root.pular-atualizacao;
                            }

                        CheckBox {
                            text: "Substituir o que já existir na pasta";
                            checked <=> root.sobrescrever-extrair;
                            }
                    }
                }

                if root.secao == 3: VerticalLayout {
                    spacing: 14px;
                    CampoCaminho {
                        rotulo: "Pasta do jogo (com o default.xex ou default.xbe)";
                        caminho: root.pasta-criar;
                        escolher => {
                            root.escolher(3);
                        }
                    }

                    CampoCaminho {
                        rotulo: "ISO a criar";
                        caminho: root.saida-criar;
                        vazio: "Escolha primeiro a pasta do jogo";
                        ativo: root.pasta-criar != "";
                        escolher => {
                            root.escolher(4);
                        }
                    }

                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        CheckBox {
                            text: "Liberar a checagem de mídia (Xbox original)";
                            checked <=> root.liberar-midia;
                            }

                        CheckBox {
                            text: "Substituir a ISO se já existir";
                            checked <=> root.sobrescrever-criar;
                            }
                    }
                }

                if root.secao == 4: VerticalLayout {
                    spacing: 14px;
                    CheckBox {
                        text: "Trocar a ISO original pela reescrita (só depois de ela estar pronta e conferida)";
                        checked <=> root.substituir-original;
                    }

                    CampoCaminho {
                        rotulo: "ISO reescrita";
                        caminho: root.substituir-original ? "no lugar da original" : root.todos ? "" : root.saida-reescrever;
                        vazio: "<nome>.xiso.iso ao lado de cada ISO";
                        ativo: !root.substituir-original && !root.todos;
                        escolher => {
                            root.escolher(5);
                        }
                    }

                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        CheckBox {
                            text: "Liberar a checagem de mídia (Xbox original)";
                            checked <=> root.liberar-midia;
                            }

                        CheckBox {
                            text: "Substituir a ISO reescrita se já existir";
                            checked <=> root.sobrescrever-reescrever;
                            enabled: !root.substituir-original;
                        }
                    }
                }

                if root.aviso-acao != "": Text {
                    text: root.aviso-acao;
                    color: Tema.aviso;
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    Botao {
                        texto: root.ocupado ? "Pôr na fila" : root.secao == 1 ? "Converter" : root.secao == 2 ? "Extrair" : root.secao == 3 ? "Criar ISO" : root.secao == 4 ? "Reescrever" : "Verificar";
                        min-width: 160px;
                        ativo: root.secao == 3 ? root.pasta-criar != "" : root.tem-jogo || (root.todos && root.jogos.length > 0);
                        clicado => {
                            root.iniciar(root.secao);
                        }
                    }
                }
            }

            if root.secao == 6: VerticalLayout {
                spacing: 18px;
                vertical-stretch: 1;
                Titulo {
                    titulo: "Configurações";
                    descricao: "As ferramentas, a pasta e as threads valem também para o menu do terminal (config.json).";
                }

                CampoCaminho {
                    rotulo: "extract-xiso-pt  ·  " + root.cfg-extract-estado;
                    caminho: root.cfg-extract;
                    vazio: "Não encontrado";
                    escolher => {
                        root.cfg-escolher(2);
                    }
                }

                CampoCaminho {
                    rotulo: "iso2god-pt  ·  " + root.cfg-iso2god-estado;
                    caminho: root.cfg-iso2god;
                    vazio: "Não encontrado";
                    escolher => {
                        root.cfg-escolher(3);
                    }
                }

                CampoCaminho {
                    rotulo: "Pasta padrão (onde o Adicionar abre, e o destino inicial dos pacotes GOD)";
                    caminho: root.cfg-pasta;
                    escolher => {
                        root.cfg-escolher(1);
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "Threads da conversão para GOD";
                        color: Tema.texto-fraco;
                        vertical-alignment: center;
                    }

                    SpinBox {
                        width: 110px;
                        minimum: 1;
                        maximum: 32;
                        value <=> root.cfg-threads;
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Desenho da janela";
                        color: Tema.texto-fraco;
                        font-size: 12px;
                    }

                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Opcao {
                            texto: "Processador (recomendado, ~30 MB)";
                            marcado: !root.cfg-gpu;
                            clicado => {
                                root.cfg-gpu = false;
                            }
                        }

                        Opcao {
                            texto: "Placa de vídeo (OpenGL, ~100 MB)";
                            marcado: root.cfg-gpu;
                            clicado => {
                                root.cfg-gpu = true;
                            }
                        }
                    }

                    Text {
                        text: "Agora: " + root.renderizador + (root.cfg-gpu != (root.renderizador != "processador") ? "  ·  a mudança vale na próxima vez que a janela abrir" : "");
                        color: #8b949e;
                        font-size: 12px;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }
            }

            // ── painel de tarefas ───────────────────────────────────────
            Painel {
                height: root.tarefa-estado == 1 ? 96px : 64px;
                border-color: root.tarefa-estado == 2 ? #4ade8066 : root.tarefa-estado == 3 ? #f8514966 : root.tarefa-estado == 5 ? #f0b42966 : Tema.painel-borda;

                if root.tarefa-estado == 0: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text {
                        text: "Nenhuma tarefa em andamento";
                        color: Tema.texto-fraco;
                        vertical-alignment: center;
                    }

                    Rectangle { }

                    Text {
                        text: root.renderizador;
                        color: #8b949e80;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                if root.tarefa-estado == 1: VerticalLayout {
                    padding: 14px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.tarefa-titulo;
                            color: Tema.texto;
                            font-weight: 600;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        if root.fila > 0: Text {
                            text: root.fila == 1 ? "mais 1 na fila" : "mais " + root.fila + " na fila";
                            color: Tema.texto-fraco;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Rectangle { }

                        if root.fila > 0 && !root.cancelando: Botao {
                            texto: "Esvaziar fila";
                            secundario: true;
                            height: 30px;
                            clicado => {
                                root.esvaziar-fila();
                            }
                        }

                        Botao {
                            texto: root.cancelando ? "Cancelando…" : root.fila > 0 ? "Cancelar tudo" : "Cancelar";
                            secundario: true;
                            height: 30px;
                            ativo: !root.cancelando;
                            clicado => {
                                root.cancelar();
                            }
                        }
                    }

                    // a barra; sem total conhecido, só o trilho
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: #ffffff14;
                        Rectangle {
                            x: 0;
                            width: parent.width * max(0, min(1, root.tarefa-fracao));
                            height: parent.height;
                            border-radius: 3px;
                            background: root.cancelando ? Tema.texto-fraco : Tema.realce;
                        }
                    }

                    Text {
                        text: root.tarefa-detalhe;
                        color: Tema.texto-fraco;
                        font-size: 12px;
                        overflow: elide;
                    }
                }

                if root.tarefa-estado >= 2: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 10px;
                    Text {
                        text: root.tarefa-estado == 2 ? "✓" : root.tarefa-estado == 4 ? "■" : "!";
                        color: root.tarefa-estado == 2 ? Tema.realce : root.tarefa-estado == 3 ? #f85149 : root.tarefa-estado == 5 ? Tema.aviso : Tema.texto-fraco;
                        font-size: 18px;
                        font-weight: 700;
                        width: 20px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: root.tarefa-titulo;
                            color: Tema.texto;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.tarefa-detalhe;
                            color: Tema.texto-fraco;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }

                    if root.tarefa-pasta != "": Botao {
                        texto: "Abrir pasta";
                        secundario: true;
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        clicado => {
                            root.abrir-pasta();
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        background: limpar.has-hover ? #ffffff1a : transparent;
                        Image {
                            source: @image-url("imagens/icones/fechar.svg");
                            colorize: Tema.texto-fraco;
                            width: 16px;
                            height: 16px;
                        }

                        limpar := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.limpar-tarefa();
                            }
                        }
                    }
                }
            }
        }
    }
}
